<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="NG">
    <texcoord name="uv" type="vector2" />
    <multiply name="tc" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="8" /></multiply>
    <noise2d name="color" type="color3"><input name="texcoord" type="vector2" nodename="tc" /><input name="amplitude" type="vector3" value="0.5, 0.5, 0.5" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <noise2d name="rough" type="float"><input name="texcoord" type="vector2" nodename="tc" /><input name="amplitude" type="float" value="0.5" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <output name="out_color" type="color3" nodename="color" />
    <output name="out_rough" type="float" nodename="rough" />
  </nodegraph>
  <standard_surface name="SS" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG" output="out_color" />
    <input name="specular_roughness" type="float" nodegraph="NG" output="out_rough" />
  </standard_surface>
  <surfacematerial name="M" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SS" />
  </surfacematerial>
</materialx>
