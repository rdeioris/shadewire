<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="NG">
    <texcoord name="uv" type="vector2" />
    <extract name="u" type="float"><input name="in" type="vector2" nodename="uv" /><input name="index" type="integer" value="0" /></extract>
    <extract name="v" type="float"><input name="in" type="vector2" nodename="uv" /><input name="index" type="integer" value="1" /></extract>
    <multiply name="u8" type="float"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" value="8" /></multiply>
    <multiply name="v8" type="float"><input name="in1" type="float" nodename="v" /><input name="in2" type="float" value="8" /></multiply>
    <combine3 name="pos" type="vector3"><input name="in1" type="float" nodename="u8" /><input name="in2" type="float" nodename="v8" /><input name="in3" type="float" value="0.5" /></combine3>
    <fractal3d name="color" type="color3"><input name="position" type="vector3" nodename="pos" /><input name="amplitude" type="vector3" value="0.5, 0.5, 0.5" /></fractal3d>
    <fractal3d name="rough" type="float"><input name="position" type="vector3" nodename="pos" /><input name="octaves" type="integer" value="4" /><input name="lacunarity" type="float" value="1.7" /><input name="diminish" type="float" value="0.6" /></fractal3d>
    <output name="out_color" type="color3" nodename="color" />
    <output name="out_rough" type="float" nodename="rough" />
  </nodegraph>
  <standard_surface name="SS" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG" output="out_color" />
    <input name="specular_roughness" type="float" nodegraph="NG" output="out_rough" />
  </standard_surface>
  <surfacematerial name="M" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SS" />
  </surfacematerial>
</materialx>
