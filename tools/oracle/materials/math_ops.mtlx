<?xml version="1.0"?>
<materialx version="1.39">
  <nodegraph name="NG">
    <texcoord name="uv" type="vector2" />
    <extract name="u" type="float"><input name="in" type="vector2" nodename="uv" /><input name="index" type="integer" value="0" /></extract>
    <extract name="v" type="float"><input name="in" type="vector2" nodename="uv" /><input name="index" type="integer" value="1" /></extract>
    <multiply name="u3" type="float"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" value="3" /></multiply>
    <modulo name="m" type="float"><input name="in1" type="float" nodename="u3" /><input name="in2" type="float" value="1" /></modulo>
    <smoothstep name="s" type="float"><input name="in" type="float" nodename="m" /><input name="low" type="float" value="0.2" /><input name="high" type="float" value="0.8" /></smoothstep>
    <remap name="r" type="float"><input name="in" type="float" nodename="v" /><input name="inlow" type="float" value="0" /><input name="inhigh" type="float" value="1" /><input name="outlow" type="float" value="0.25" /><input name="outhigh" type="float" value="0.75" /></remap>
    <combine3 name="c" type="color3"><input name="in1" type="float" nodename="s" /><input name="in2" type="float" nodename="r" /><input name="in3" type="float" nodename="m" /></combine3>
    <mix name="color" type="color3"><input name="fg" type="color3" nodename="c" /><input name="bg" type="color3" value="0.1, 0.5, 0.9" /><input name="mix" type="float" nodename="v" /></mix>
    <power name="p" type="float"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" value="2.2" /></power>
    <sqrt name="q" type="float"><input name="in" type="float" nodename="v" /></sqrt>
    <mix name="rough" type="float"><input name="fg" type="float" nodename="p" /><input name="bg" type="float" nodename="q" /><input name="mix" type="float" value="0.3" /></mix>
    <output name="out_color" type="color3" nodename="color" />
    <output name="out_rough" type="float" nodename="rough" />
  </nodegraph>
  <standard_surface name="SS" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG" output="out_color" />
    <input name="specular_roughness" type="float" nodegraph="NG" output="out_rough" />
  </standard_surface>
  <surfacematerial name="M" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SS" />
  </surfacematerial>
</materialx>
