---
c0 = dielectric_bsdf(ior=c0_ior, normal=c0_normal, retroreflective=c0_retroreflective, roughness=c0_roughness, tangent=c0_tangent, thinfilm_ior=c0_thinfilm_ior, thinfilm_thickness=c0_thinfilm_thickness, tint=c0_tint, weight=c0_weight, distribution="ggx", scatter_mode="R")
c1 = oren_nayar_diffuse_bsdf(color=c1_color, energy_compensation=c1_energy_compensation, normal=c1_normal, roughness=c1_roughness, weight=c1_weight)
c2 = layer(top=c0, base=c1)
c3 = uniform_edf(color=c3_color)
c4 = empty_edf
c5 = mix(fg=c3, bg=c4, mix=c5_mix)
c6 = multiply(c5, c6_in2)
bsdf = c2
edf = c6
opacity = opacity
