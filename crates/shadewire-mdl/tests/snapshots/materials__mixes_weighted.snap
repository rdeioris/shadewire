---
c0 = oren_nayar_diffuse_bsdf(color=c0_color, energy_compensation=c0_energy_compensation, normal=c0_normal, roughness=c0_roughness, weight=c0_weight)
c1 = multiply(c0, c1_in2)
c2 = translucent_bsdf(color=c2_color, normal=c2_normal, weight=c2_weight)
c3 = layer(top=c1, base=c2)
bsdf = c3
edf = none
opacity = opacity
