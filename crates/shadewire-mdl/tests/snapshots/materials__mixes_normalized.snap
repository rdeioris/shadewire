c0 = oren_nayar_diffuse_bsdf(color=c0_color, energy_compensation=c0_energy_compensation, normal=c0_normal, roughness=c0_roughness, weight=c0_weight)
c1 = generalized_schlick_bsdf(color0=c1_color0, color82=c1_color82, color90=c1_color90, exponent=c1_exponent, normal=c1_normal, retroreflective=c1_retroreflective, roughness=c1_roughness, tangent=c1_tangent, thinfilm_ior=c1_thinfilm_ior, thinfilm_thickness=c1_thinfilm_thickness, weight=c1_weight, distribution="ggx", scatter_mode="R")
c2 = mix(fg=c0, bg=c1, mix=c2_mix)
bsdf = c2
edf = none
opacity = opacity
