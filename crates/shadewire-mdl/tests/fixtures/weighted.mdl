mdl 1.7;
import ::df::*;
import ::anno::*;
export material over_diffuse(float w = 0.0) = material(surface: material_surface(scattering: df::weighted_layer(
    weight: w,
    layer: df::fresnel_factor(ior: color(0.2), extinction_coefficient: color(3.0), base: df::microfacet_ggx_smith_bsdf(roughness_u: 0.1)),
    base: df::diffuse_reflection_bsdf(tint: color(0.5)))));
export material split() = material(surface: material_surface(scattering: df::normalized_mix(df::bsdf_component[](
    df::bsdf_component(0.3, df::diffuse_reflection_bsdf(tint: color(0.5))),
    df::bsdf_component(0.7, df::fresnel_factor(ior: color(0.2), extinction_coefficient: color(3.0), base: df::microfacet_ggx_smith_bsdf(roughness_u: 0.1)))))));
export material partial() = material(surface: material_surface(scattering: df::unbounded_mix(df::bsdf_component[](
    df::bsdf_component(0.3, df::diffuse_reflection_bsdf(tint: color(0.5))),
    df::bsdf_component(0.3, df::diffuse_transmission_bsdf())))));
