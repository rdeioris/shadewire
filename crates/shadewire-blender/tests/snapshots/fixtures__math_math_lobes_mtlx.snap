    </multiply>
    <add name="Mix_LINEAR_LIGHT_6" type="color3">
      <input name="in1" type="color3" nodename="Mix_SOFT_LIGHT_10" />
      <input name="in2" type="color3" nodename="Mix_LINEAR_LIGHT_5" />
    </add>
    <add name="Mix_EXCLUSION_2" type="color3">
      <input name="in1" type="color3" nodename="Mix_LINEAR_LIGHT_6" />
      <input name="in2" type="color3" interfacename="Mix_EXCLUSION_B" />
    </add>
    <multiply name="Mix_EXCLUSION_3" type="color3">
      <input name="in1" type="color3" nodename="Mix_LINEAR_LIGHT_6" />
      <input name="in2" type="color3" interfacename="Mix_EXCLUSION_B" />
    </multiply>
    <multiply name="Mix_EXCLUSION_4" type="color3">
      <input name="in1" type="color3" nodename="Mix_EXCLUSION_3" />
      <input name="in2" type="color3" value="2, 2, 2" />
    </multiply>
    <subtract name="Mix_EXCLUSION_5" type="color3">
      <input name="in1" type="color3" nodename="Mix_EXCLUSION_2" />
      <input name="in2" type="color3" nodename="Mix_EXCLUSION_4" />
    </subtract>
    <mix name="Mix_EXCLUSION_6" type="color3">
      <input name="fg" type="color3" nodename="Mix_EXCLUSION_5" />
      <input name="bg" type="color3" nodename="Mix_LINEAR_LIGHT_6" />
      <input name="mix" type="float" nodename="Mix_EXCLUSION" />
    </mix>
    <multiply name="Emission_color" type="color3">
      <input name="in1" type="color3" nodename="Mix_EXCLUSION_6" />
      <input name="in2" type="float" nodename="Map_Range_Smooth_15" />
    </multiply>
    <output name="color" type="color3" nodename="Emission_color" />
  </nodegraph>
  <uniform_edf name="math_uniform_edf_0" type="EDF">
    <input name="color" type="color3" nodegraph="NG_math" output="color" />
  </uniform_edf>
  <surface name="math_shader" type="surfaceshader">
    <input name="edf" type="EDF" nodename="math_uniform_edf_0" />
  </surface>
  <surfacematerial name="math" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="math_shader" />
  </surfacematerial>
</materialx>
